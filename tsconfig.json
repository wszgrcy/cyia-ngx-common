{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "paths": {
      "@cyia/ngx-common": ["./lib/src"],
      "@cyia/ngx-common/*": ["./lib/src/*"]
    },
    "rootDir": "."
  },
  "include": [],
  "files": [],
  "references": [
    {
      "path": "./lib/tsconfig.lib.json"
    },
    {
      "path": "./lib/tsconfig.spec.json"
    },
    {
      "path": "./examples/tsconfig.json"
    }
  ]
}
